# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le serveur.

PORT=3000

# Identifiants du panneau admin (choisis des valeurs solides)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret utilisé pour signer les cookies de session admin
COOKIE_SECRET=change-this-to-a-long-random-string

# Code d'accès initial : 1221
ADMIN_ACCESS_CODE=1221
